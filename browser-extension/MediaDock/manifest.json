{
  "manifest_version": 3,
  "name": "MediaDock Browser Handler",
  "version": "2.5.0",
  "description": "MediaDock adjustable IDM-style media grabber with per-tab stream detection, HLS quality variants, embedded-player awareness, native messaging, universal downloads, and torrent/magnet handoff.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-media-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "floating-grabber.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "MediaDock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "send-to-mediadock": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Send current page to MediaDock"
    }
  }
}
