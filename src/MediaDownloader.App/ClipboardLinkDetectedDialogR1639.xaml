<Window x:Class="MediaDownloader.ClipboardLinkDetectedDialogR1639"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media link detected"
        Width="500" Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource ThemePrimaryTextBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="ClipboardDialogButtonR1639" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ClipboardAnalyzeButtonR1639" TargetType="Button" BasedOn="{StaticResource ClipboardDialogButtonR1639}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
    </Style>
  </Window.Resources>
  <Border Margin="10"
          Padding="18"
          Background="{DynamicResource ThemePanelBackgroundBrush}"
          BorderBrush="{DynamicResource ThemeStrongBorderBrush}"
          BorderThickness="1"
          CornerRadius="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Media link detected" FontSize="17" FontWeight="SemiBold"/>
      <StackPanel Grid.Row="2">
        <TextBlock Text="MediaDock found a supported media link in the clipboard." Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontSize="10.5"/>
        <Border Margin="0,9,0,0" Padding="10,8" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8">
          <TextBlock x:Name="DetectedUrlTextR1639" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="9.5"/>
        </Border>
        <TextBlock Margin="0,8,0,0" Text="Analyze only fills MediaDock and starts metadata analysis. It never starts a download automatically." Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.7" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button MinWidth="100" Margin="0,0,8,0" Padding="14,7" Style="{StaticResource ClipboardDialogButtonR1639}" Content="Ignore" IsCancel="True" Click="Ignore_Click"/>
        <Button MinWidth="120" Padding="14,7" Style="{StaticResource ClipboardAnalyzeButtonR1639}" Content="Analyze" IsDefault="True" Click="Analyze_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
