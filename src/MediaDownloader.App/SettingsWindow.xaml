<Window x:Class="MediaDownloader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaDock Settings" Icon="Assets/MediaDock.ico"
        Width="740" Height="560" MinWidth="740" MinHeight="560" MaxWidth="740" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent"
        Foreground="{DynamicResource ThemePrimaryTextBrush}" FontFamily="Segoe UI"
        WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowsTransparency="True" SizeToContent="Manual"
        Loaded="SettingsWindowR1636_Loaded">
  <Window.Resources>
    <!-- MEDIADOCK_PREMIUM_SETTINGS_R1633 -->
    <!-- MEDIADOCK_PREMIUM_SETTINGS_NAV_POLISH_R1636 -->
    <!-- MEDIADOCK_PREMIUM_SETTINGS_NAV_MOTION_ICONS_R1636 -->
    <Geometry x:Key="SIconGear">M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9</Geometry>
    <Geometry x:Key="SIconAudio">M4,12 L6,12 M7,8 L7,16 M10,5 L10,19 M13,9 L13,15 M16,6 L16,18 M19,10 L19,14</Geometry>
    <Geometry x:Key="SIconDownload">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</Geometry>
    <Geometry x:Key="SIconFolder">M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z</Geometry>
    <Geometry x:Key="SIconAppearance">M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7 M12,3 L12,5 M12,19 L12,21 M3,12 L5,12 M19,12 L21,12 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4</Geometry>
    <Geometry x:Key="SIconWindow">M4,5 L20,5 L20,19 L4,19 Z M4,9 L20,9 M7,7 L7.1,7 M10,7 L10.1,7</Geometry>
    <Geometry x:Key="SIconUpdate">M6,8 A7,7 0 0 1 18,7 M18,7 L18,3 M18,7 L14,7 M18,16 A7,7 0 0 1 6,17 M6,17 L6,21 M6,17 L10,17</Geometry>
    <Geometry x:Key="SIconInfo">M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 M9.5,9 A2.5,2.5 0 0 1 14.5,9 C14.5,11 12,11 12,13 M12,16 L12,16.1</Geometry>
    <Geometry x:Key="SIconClose">M5,5 L19,19 M19,5 L5,19</Geometry>

    <Style x:Key="SettingCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckSurface"
                      Width="15"
                      Height="15"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeInputBackgroundBrush}"
                      BorderBrush="{DynamicResource ThemeStrongBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <Path x:Name="CheckGlyph"
                      Width="9"
                      Height="7"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="Fill"
                      Stroke="White"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M1,4 L3.5,6.5 L8,1"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                Content="{TemplateBinding Content}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingComboBoxItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
              <Grid Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" /><Path Grid.Column="1" Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeSecondaryTextBrush}" Data="M 0 0 L 4 4 L 8 0 Z" /></Grid>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template></ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"><Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer Margin="4" MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></Border></Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" /></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="SettingsSectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="9.5" />
    </Style>
    <Style x:Key="SettingsNavButtonR1636" TargetType="RadioButton">
      <Setter Property="Height" Value="38" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,0,10,0" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="NavSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource ThemeAccentPanelBrush}" />
                <Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource ThemeAccentSoftBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="NavSurface" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsScrollBarR1636" TargetType="ScrollBar">
      <Setter Property="Width" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Width="{TemplateBinding Width}">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="28" Margin="2,2">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Background="{DynamicResource ThemeStrongBorderBrush}"
                                CornerRadius="3"
                                Opacity="0.72" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.9" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            <Setter TargetName="ThumbSurface" Property="Opacity" Value="1" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" /><Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,7" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeHoverBrush}" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsTitleCloseButton" TargetType="Button">
      <Setter Property="Width" Value="44" /><Setter Property="Height" Value="58" /><Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#A51D14" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border Margin="10" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="14">
    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.28" Color="#000000" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="50" /></Grid.RowDefinitions>
      <Border x:Name="SettingsTitleCornerClipR19" Grid.Row="0" CornerRadius="14,14,0,0" Background="{DynamicResource ThemeTitleBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource ThemeAccentPanelBrush}" CornerRadius="10"><Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="{StaticResource SIconGear}" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1.55" Fill="Transparent" /></Viewbox></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Settings" FontWeight="SemiBold" FontSize="16" /><TextBlock Margin="0,2,0,0" Text="Customize MediaDock to your preference. Changes save automatically." Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.5" /></StackPanel>
          <Button Grid.Column="2" Style="{StaticResource SettingsTitleCloseButton}" ToolTip="Close Settings" Click="Close_Click"><Viewbox Width="16" Height="16"><Path Data="{StaticResource SIconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Fill="Transparent" /></Viewbox></Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="166" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource ThemeWindowBackgroundBrush}">
          <StackPanel Margin="10,12">
            <TextBlock Text="SETTINGS"
                       Margin="10,0,0,8"
                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                       FontSize="8"
                       FontWeight="SemiBold" />

            <Grid x:Name="SettingsNavButtonsHostR1636">
              <Border x:Name="SettingsNavIndicatorR1636"
                      Width="3"
                      Height="22"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="2,0,0,0"
                      Background="{DynamicResource ThemeAccentBrush}"
                      CornerRadius="2"
                      IsHitTestVisible="False"
                      Panel.ZIndex="4">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="SettingsNavIndicatorTransformR1636" Y="8" />
                </Border.RenderTransform>
              </Border>

              <StackPanel>
                <RadioButton x:Name="SettingsNavAudioR1636"
                             GroupName="SettingsNavigationR1636"
                             IsChecked="True"
                             Tag="Audio"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconAudio}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Audio Processing" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNavDownloadR1636"
                             GroupName="SettingsNavigationR1636"
                             Tag="Download"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconDownload}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Download" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNavOutputR1636"
                             GroupName="SettingsNavigationR1636"
                             Tag="Output"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconFolder}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Output Folder" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNavAppearanceR1636"
                             GroupName="SettingsNavigationR1636"
                             Tag="Appearance"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconAppearance}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Appearance" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNavWindowR1636"
                             GroupName="SettingsNavigationR1636"
                             Tag="Window"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconWindow}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Window" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNavUpdatesR1636"
                             GroupName="SettingsNavigationR1636"
                             Tag="Updates"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconUpdate}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Updates" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SettingsNavSupportR1636"
                             GroupName="SettingsNavigationR1636"
                             Tag="Support"
                             Click="SettingsNavR1636_Click"
                             Style="{StaticResource SettingsNavButtonR1636}">
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" Margin="0,0,9,0">
                      <Path Data="{StaticResource SIconInfo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                    <TextBlock Text="Support" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="9.5" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Grid>

            <Border Margin="0,14,0,0"
                    Background="{DynamicResource ThemeAccentPanelBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="9">
              <StackPanel>
                <TextBlock Text="MediaDock" FontSize="9.5" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,0"
                           Text="Premium desktop utility"
                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                           FontSize="7.8" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource ThemeBorderBrush}" />
        <ScrollViewer x:Name="SettingsContentScrollViewer"
                      Grid.Column="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Focusable="False"
                      ClipToBounds="True"
                      ScrollChanged="SettingsContentScrollViewerR1636_ScrollChanged">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SettingsScrollBarR1636}" />
          </ScrollViewer.Resources>
          <StackPanel x:Name="SettingsContentStack" Margin="16,14,14,16">
            <TextBlock x:Name="SettingsSectionAudioR1636" Style="{StaticResource SettingsSectionLabel}" Text="AUDIO PROCESSING" />
            <Border Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><StackPanel><CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AudioFadeInOut3Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="3-second audio fade in / fade out" /><TextBlock Margin="22,3,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.3" TextWrapping="Wrap" Text="Applies to MP3 downloads and local MP3 conversions." /><Border Height="1" Margin="0,10" Background="{DynamicResource ThemeBorderBrush}" /><CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding TrimBoundarySilence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Remove silence at the start and end" /><TextBlock Margin="22,3,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.3" TextWrapping="Wrap" Text="Trims boundary dead air only. Interior pauses are preserved." /></StackPanel></Border>

            <TextBlock x:Name="SettingsSectionDownloadR1636" Margin="0,12,0,0" Style="{StaticResource SettingsSectionLabel}" Text="DOWNLOAD" />
            <Border Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><StackPanel><CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AutoRemoveTikTokWatermark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Auto-remove TikTok watermark" /><TextBlock Margin="22,3,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.3" TextWrapping="Wrap" Text="Prefers a watermark-free TikTok source when yt-dlp exposes one. Falls back safely if unavailable." /></StackPanel></Border>

            <TextBlock x:Name="SettingsSectionOutputR1636" Margin="0,12,0,0" Style="{StaticResource SettingsSectionLabel}" Text="OUTPUT FOLDER" />
            <Border Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Download save location" FontWeight="SemiBold" FontSize="10.5" /><TextBlock x:Name="SettingsOutputFolderPathR1630" Margin="0,4,0,0" Text="{Binding OutputDirectory, Mode=OneWay}" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.3" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectory, Mode=OneWay}" /></StackPanel><Button x:Name="SettingsBrowseOutputFolderR1630" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource CloseButton}" Command="{Binding BrowseOutputDirectoryCommand}" Content="Browse" ToolTip="Choose output folder" /><Button x:Name="SettingsOpenOutputFolderR1630" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource CloseButton}" Command="{Binding OpenDownloadsCommand}" Content="Open" ToolTip="Open output folder" /></Grid></Border>

            <TextBlock x:Name="SettingsSectionAppearanceR1636" Margin="0,12,0,0" Style="{StaticResource SettingsSectionLabel}" Text="APPEARANCE" />
            <Border Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Theme" FontWeight="SemiBold" FontSize="10.5" /><ComboBox Margin="0,5,0,0" Style="{StaticResource SettingComboBox}" ItemsSource="{Binding ThemeChoices, Mode=OneWay}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.5" TextWrapping="Wrap" Text="{Binding ThemeDescription, Mode=OneWay}" /></Grid></Border>

            <TextBlock x:Name="SettingsSectionWindowR1636" Margin="0,12,0,0" Style="{StaticResource SettingsSectionLabel}" Text="WINDOW" />
            <Border Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><StackPanel><CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AlwaysOpenMaximized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Always open maximized" /><TextBlock Margin="22,3,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.3" TextWrapping="Wrap" Text="Uses the Windows working area, so the taskbar remains visible." /></StackPanel></Border>

            <TextBlock x:Name="SettingsSectionUpdatesR1636" Margin="0,12,0,0" Style="{StaticResource SettingsSectionLabel}" Text="UPDATES" />
            <Border Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MediaDock Update" FontWeight="SemiBold" FontSize="10.5" /><TextBlock x:Name="UpdateStatusTextR1620" Margin="0,4,14,0" Text="Check for the latest MediaDock improvements." Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontSize="8.3" TextWrapping="Wrap" /></StackPanel><Button x:Name="CheckForUpdatesButtonR1620" Grid.Column="1" Content="Check Now" Click="CheckForUpdatesButtonR1620_Click" VerticalAlignment="Center" Style="{StaticResource CloseButton}" MinWidth="120" /></Grid></Border>

            <TextBlock x:Name="SettingsSectionSupportR1636" Margin="0,12,0,0" Style="{StaticResource SettingsSectionLabel}" Text="SUPPORT &amp; DIAGNOSTICS" />
            <Border x:Name="SupportDiagnosticsCard" Margin="0,5,0,0" Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="10.5" /><TextBlock Margin="0,4,16,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.3" TextWrapping="Wrap" Text="Technical troubleshooting and engine status. Most users will not need this." /></StackPanel><Button Grid.Column="1" Style="{StaticResource CloseButton}" ToolTip="Open Diagnostics" Click="OpenDiagnostics_Click" Content="Open Diagnostics" /></Grid></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="SettingsFooter" Grid.Row="2" Background="{DynamicResource ThemeTitleBarBackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button Style="{StaticResource CloseButton}" ToolTip="Buy a MediaDock license on Payhip" Click="BuyLicense_Click" Content="Buy License" /><Button x:Name="EnterSerialSettingsButtonR188" Margin="7,0,0,0" Style="{StaticResource CloseButton}" Content="Enter Serial" Click="EnterSerialSettingsButtonR188_Click" ToolTip="Activate MediaDock with your Payhip serial or license key" /></StackPanel><TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Changes save automatically" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="8.2" /><Button Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource CloseButton}" Content="Close" Click="Close_Click" ToolTip="Close Settings" /></Grid>
    </Grid>
  </Border>
</Window>