<Window x:Class="MediaDownloader.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MediaDock Settings" Icon="Assets/MediaDock.ico" Width="700" Height="540" MinWidth="700" MinHeight="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="Transparent" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontFamily="Segoe UI" WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowsTransparency="True" MaxWidth="700" MaxHeight="540" SizeToContent="Manual">
  <Window.Resources>
    <Style x:Key="SettingCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SettingComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingComboBoxItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" />
                <Path Grid.Column="1" Width="8" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeSecondaryTextBrush}" Data="M 0 0 L 4 4 L 8 0 Z" />
              </Grid>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource ThemePanelBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="7">
                  <ScrollViewer Margin="4" MaxHeight="260" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources></ScrollViewer.Resources>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DoneBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DoneBorder" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                <Setter TargetName="DoneBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Explicit Windows-style close behavior. The glyph never inherits the
             pale default WPF hover background, so it cannot disappear in any theme. -->
    <Style x:Key="SettingsTitleCloseButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CloseSurface" Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CloseSurface" Property="Background" Value="#A51D14" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="2" CornerRadius="12" Background="{DynamicResource ThemePanelBackgroundBrush}" Margin="14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.88" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="0" />
      </Grid.RowDefinitions>
      <Border x:Name="SettingsTitleCornerClipR19" Grid.Row="0" CornerRadius="12,12,0,0" Background="{DynamicResource ThemeTitleBarBackgroundBrush}" SnapsToDevicePixels="True">
        <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="44" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Saved automatically and restored after restart" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource SettingsTitleCloseButton}" Content="X" ToolTip="Close Settings" Click="Close_Click" Foreground="{DynamicResource ThemePrimaryTextBrush}" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="SettingsContentScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Padding="0" Focusable="False" ClipToBounds="True">
        <ScrollViewer.Resources>
          <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Opacity" Value="0.92" />
          </Style>
        </ScrollViewer.Resources>
        <StackPanel x:Name="SettingsContentStack" Margin="14,5,14,2">
          <TextBlock Text="AUDIO PROCESSING" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,0" />
          <Border Margin="0,2,0,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <StackPanel>
              <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AudioFadeInOut3Seconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="3-second audio fade in / fade out" />
              <TextBlock Margin="24,2,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" TextWrapping="Wrap" Text="Applies to MP3 downloads and local MP3 conversions." />
              <CheckBox Margin="0,9,0,0" Style="{StaticResource SettingCheckBox}" IsChecked="{Binding TrimBoundarySilence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Remove silence at the start and end" />
              <TextBlock Margin="24,2,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" TextWrapping="Wrap" Text="Trims boundary dead air only. Interior pauses are preserved." />
            </StackPanel>
          </Border>
          <TextBlock Margin="0,4,0,0" Text="DOWNLOAD" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" FontSize="10" />
          <Border Margin="0,2,0,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <StackPanel>
              <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AutoRemoveTikTokWatermark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Auto-remove TikTok watermark" />
              <TextBlock Margin="24,2,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" TextWrapping="Wrap" Text="Prefers a watermark-free TikTok source when yt-dlp exposes one. Falls back safely if unavailable." />
            </StackPanel>
          </Border>
                          <!-- MEDIADOCK_SETTINGS_OUTPUT_FOLDER_R1630 -->
                <TextBlock Margin="0,14,0,0"
                           Text="OUTPUT FOLDER"
                           Foreground="{DynamicResource ThemeAccentBrush}"
                           FontWeight="SemiBold"
                           FontSize="10"/>
                <Border Margin="0,8,0,0"
                        Background="{DynamicResource ThemeSurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Download save location"
                                       Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"/>
                            <TextBlock x:Name="SettingsOutputFolderPathR1630"
                                       Margin="0,4,0,0"
                                       Text="{Binding OutputDirectory, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OutputDirectory, Mode=OneWay}"/>
                        </StackPanel>
                        <Button x:Name="SettingsBrowseOutputFolderR1630"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CloseButton}"
                                Padding="11,7"
                                Command="{Binding BrowseOutputDirectoryCommand}"
                                Content="Browse"
                                ToolTip="Choose output folder"/>
                        <Button x:Name="SettingsOpenOutputFolderR1630"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CloseButton}"
                                Padding="11,7"
                                Command="{Binding OpenDownloadsCommand}"
                                Content="Open"
                                ToolTip="Open output folder"/>
                    </Grid>
                </Border>
<TextBlock Margin="0,4,0,0" Text="APPEARANCE" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" FontSize="10" />
          <Border Margin="0,2,0,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Theme" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontWeight="SemiBold" FontSize="12" />
                <ComboBox Margin="0,5,0,0" Style="{StaticResource SettingComboBox}" ItemsSource="{Binding ThemeChoices, Mode=OneWay}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9.5" TextWrapping="Wrap" Text="{Binding ThemeDescription, Mode=OneWay}" />
            </Grid>
          </Border>
          <TextBlock Margin="0,4,0,0" Text="WINDOW" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" FontSize="10" />
          <Border Margin="0,2,0,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <StackPanel>
              <CheckBox Style="{StaticResource SettingCheckBox}" IsChecked="{Binding AlwaysOpenMaximized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Always open maximized" />
              <TextBlock Margin="24,2,0,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" TextWrapping="Wrap" Text="Uses the Windows working area, so the taskbar remains visible." />
            </StackPanel>
          </Border>
          <StackPanel Margin="0,18,0,0">
            <TextBlock Text="UPDATE" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" FontSize="10" />
            <Border Margin="0,8,0,0" Padding="14" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeStrongBorderBrush}" BorderThickness="1" CornerRadius="9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="MediaDock Update" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock x:Name="UpdateStatusTextR1620" Margin="0,4,14,0" Text="Checks the verified stable MediaDock-Release channel." Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="CheckForUpdatesButtonR1620" Grid.Column="1" Content="Check for Updates" Click="CheckForUpdatesButtonR1620_Click" Padding="14,8" VerticalAlignment="Center" Style="{StaticResource CloseButton}" MinWidth="132" />
              </Grid>
            </Border>
          </StackPanel>
          <TextBlock Margin="0,4,0,0" Text="SUPPORT &amp; DIAGNOSTICS" Foreground="{DynamicResource ThemeAccentBrush}" FontWeight="SemiBold" FontSize="10" />
          <Border x:Name="SupportDiagnosticsCard" Margin="0,2,0,0" Background="{DynamicResource ThemeSurfaceBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Diagnostics" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Margin="0,4,16,0" Foreground="{DynamicResource ThemeMutedTextBrush}" FontSize="9" TextWrapping="Wrap" Text="Technical troubleshooting and engine status. Most users will not need this." />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource CloseButton}" Padding="13,8" ToolTip="Open Diagnostics" Click="OpenDiagnostics_Click" Content="Open Diagnostics"></Button>
            </Grid>
          </Border>
          <Grid x:Name="SettingsFooter" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
              <Button Style="{StaticResource CloseButton}" Padding="14,8" ToolTip="Buy a MediaDock license on Payhip" Click="BuyLicense_Click" Content="Buy License"></Button>
              <Button x:Name="EnterSerialSettingsButtonR188" Content="Enter Serial" Click="EnterSerialSettingsButtonR188_Click" Margin="10,0,0,0" Padding="14,8" ToolTip="Activate MediaDock with your Payhip serial or license key" Style="{StaticResource CloseButton}" />
            </StackPanel>
            <Button Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource CloseButton}" Content="X" Click="Close_Click" Foreground="{DynamicResource ThemePrimaryTextBrush}" ToolTip="Close Settings" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>