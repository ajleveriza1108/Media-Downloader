<Window x:Class="MediaDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Media Downloader"
        Width="1280"
        Height="720"
        MinWidth="620"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#070D18"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="Window_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#2396FF" Offset="0" />
            <GradientStop Color="#445CFF" Offset="0.52" />
            <GradientStop Color="#8B2CFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBorderGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#37B6FF" Offset="0" />
            <GradientStop Color="#5D73FF" Offset="0.55" />
            <GradientStop Color="#A43BFF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="NeonPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#5B48FF" Opacity="0.32" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#152033" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="1" />
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="#718199" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E7EEF9" />
            <Setter Property="Background" Value="#111A2A" />
            <Setter Property="BorderBrush" Value="#2A3850" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="BorderBrush" Value="#4A7BFF" />
                                <Setter TargetName="GhostBorder" Property="Background" Value="#162239" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GhostBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EAF1FB" />
            <Setter Property="Background" Value="#0D1625" />
            <Setter Property="BorderBrush" Value="#263650" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#6E8CFF" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- URL input uses the native WPF TextBox template. The previous custom
             PART_ContentHost margin could clip glyph ascenders at some DPI/text
             scaling combinations. The outer URL strip owns all chrome. -->
        <Style x:Key="UrlTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EAF1FB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="#6E8CFF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9EFF8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1C2940" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#273653" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#10192A" />
            <Setter Property="BorderBrush" Value="#28364F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Path Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Fill="#9AA9BD"
                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                            </Grid>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#0F1828"
                                        BorderBrush="#30405C"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5977FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedListBox" TargetType="ListBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#DCE5F2" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Segment"
                                            Background="#111A2A"
                                            BorderBrush="#293850"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Segment" Property="BorderBrush" Value="#4C66C9" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Segment" Property="Background" Value="#22234B" />
                                            <Setter TargetName="Segment" Property="BorderBrush" Value="#765BFF" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="#0A1020" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8D3E2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0"
              Background="#080E19"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Grid Width="34" Height="34">
                    <Path Data="M4,3 L33,19 L4,35 Z"
                          Fill="{StaticResource AccentGradient}"
                          Stretch="Uniform"
                          Margin="2">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#2FA9FF" Opacity="0.48" />
                        </Path.Effect>
                    </Path>
                    <Path Data="M10,10 L26,19 L10,28 Z" Fill="#0A1220" Stretch="Uniform" Margin="6" />
                    <Path Data="M13,13 L24,19 L13,25 Z" Fill="#C9E7FF" Stretch="Uniform" Margin="9" />
                </Grid>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="Media Downloader"
                           FontSize="19"
                           FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Style="{StaticResource TitleBarButton}" Click="OpenDiagnostics_Click" ToolTip="Diagnostics and engine status" Content="⚙" />
                <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" Content="—" />
                <Button Style="{StaticResource TitleBarButton}" Click="MaximizeRestore_Click" Content="□" />
                <Button Style="{StaticResource TitleBarButton}" Click="Close_Click" Content="×" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContentRoot" Grid.Row="1" Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- URL strip: paste automatically triggers analysis -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource AccentBorderGradient}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Padding="1">
                <Border Background="#0C1524" CornerRadius="11">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="18" Height="18"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Fill="#93A4BB"
                              Stretch="Uniform"
                              Data="M3.9,12 C3.9,10.84 4.84,9.9 6,9.9 L10,9.9 L10,8 L6,8 C3.79,8 2,9.79 2,12 C2,14.21 3.79,16 6,16 L10,16 L10,14.1 L6,14.1 C4.84,14.1 3.9,13.16 3.9,12 M8,13 L16,13 L16,11 L8,11 M18,8 L14,8 L14,9.9 L18,9.9 C19.16,9.9 20.1,10.84 20.1,12 C20.1,13.16 19.16,14.1 18,14.1 L14,14.1 L14,16 L18,16 C20.21,16 22,14.21 22,12 C22,9.79 20.21,8 18,8 Z" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="UrlInputTextBox"
                                     Style="{StaticResource UrlTextBox}"
                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="#738095"
                                       FontSize="16"
                                       IsHitTestVisible="False"
                                       Text="Paste video or playlist URL here...">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Url}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock x:Name="UrlStatusText" Grid.Column="2"
                                   Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#7388A8"
                                   FontSize="10"
                                   Text="{Binding Status}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="230" />

                        <Button Grid.Column="3"
                                Width="38" Height="38"
                                VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}"
                                Padding="0"
                                Command="{Binding PasteUrlCommand}"
                                ToolTip="Paste URL from clipboard">
                            <Path Width="16" Height="16" Fill="#DCE6F4" Stretch="Uniform"
                                  Data="M19,3 L14.82,3 C14.4,1.84 13.3,1 12,1 C10.7,1 9.6,1.84 9.18,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 M12,3 C12.55,3 13,3.45 13,4 C13,4.55 12.55,5 12,5 C11.45,5 11,4.55 11,4 C11,3.45 11.45,3 12,3 M19,19 L5,19 L5,5 L7,5 L7,8 L17,8 L17,5 L19,5 Z" />
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <!-- Responsive panels: wide = 3 columns; medium = Media over Queue/Convert; narrow = stacked. -->
            <ScrollViewer x:Name="PanelsScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          VerticalContentAlignment="Top"
                          Padding="0,0,4,0">
            <Grid x:Name="PanelsGrid" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.05*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.78*" />
                </Grid.ColumnDefinitions>

                <!-- Panel 1: Video/media details + download choices -->
                <Border x:Name="MediaPanel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" ClipToBounds="False" Background="#0D1625" BorderBrush="#22314A" BorderThickness="1" CornerRadius="14" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="MediaSummaryGrid" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="MediaThumbnailColumn" Width="150" />
                                <ColumnDefinition x:Name="MediaThumbnailSpacerColumn" Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MediaThumbnailHost" Grid.Column="0" Height="138" Background="#09111F" CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                    <Border Width="46" Height="46" CornerRadius="23"
                                            Background="#AA15203A" BorderBrush="#7A91B8" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 0 0 L 0 18 L 15 9 Z" Fill="White" Width="15" Height="18" Stretch="Fill" Margin="20,17,17,17" />
                                    </Border>
                                    <Border Background="#D8080E18"
                                            Visibility="{Binding IsMediaReady, Converter={StaticResource BoolToVisibility}}"
                                            CornerRadius="5" Padding="7,4"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding DurationText}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid x:Name="MediaDetailsGrid" Grid.Column="2" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="MediaTitleText"
                                           Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextTrimming="None" />
                                <Grid x:Name="MediaPlatformRow" Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#17243A" CornerRadius="5" Padding="8,4" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Platform}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#DDE9F8" />
                                    </Border>
                                    <TextBlock x:Name="MediaUploaderText"
                                               Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding Uploader}"
                                               Foreground="#AFC0D5"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               TextTrimming="None" />
                                </Grid>
                                <TextBlock x:Name="MediaFormatsText" Grid.Row="2" Margin="0,8,0,0" Text="{Binding AvailableFormatsSummary}" Foreground="#61AFFF" FontSize="12" TextWrapping="Wrap" />
                                <WrapPanel x:Name="MediaAvailabilityRow"
                                           Grid.Row="3"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding IsMediaReady, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="#0B3C31"
                                            BorderBrush="#15936D"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,5"
                                            Margin="0,0,8,6">
                                        <TextBlock Text="Available"
                                                   Foreground="#63F3B8"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#292052"
                                            BorderBrush="#765BFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,5"
                                            Margin="0,0,0,6">
                                        <TextBlock Text="{Binding MediaCapabilityText}"
                                                   Foreground="#CDAEFF"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding HasAnalysisError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding AnalysisErrorText}" Foreground="#E4A5A5" FontSize="10" TextWrapping="Wrap" />
                                    <Button Margin="0,7,0,0" Width="120" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Click="OpenDiagnostics_Click" Content="View Details" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Adaptive download options: show only controls relevant to the selected format -->
                        <Border x:Name="DownloadOptionsCard" Grid.Row="2" Background="#0A1322" BorderBrush="#1F2E46" BorderThickness="1" CornerRadius="10" Padding="9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="Format" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="2"
                                             Style="{StaticResource SegmentedListBox}"
                                             ItemsSource="{Binding DownloadFormats}"
                                             SelectedItem="{Binding SelectedDownloadFormat}" />
                                </Grid>

                                <Grid x:Name="DownloadChoiceGrid" Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel x:Name="QualityChoicePanel" Grid.Row="0" Grid.Column="0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMp3Download}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Quality" />
                                        <ComboBox Margin="0,4,0,0"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemsSource="{Binding QualityChoices}"
                                                  SelectedItem="{Binding SelectedQuality}"
                                                  IsEnabled="{Binding CanChooseQuality}" />
                                    </StackPanel>

                                    <StackPanel x:Name="AudioChoicePanel" Grid.Row="0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Grid.Column" Value="2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMp3Download}" Value="True">
                                                        <Setter Property="Grid.Column" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource LabelText}" Text="Audio" />
                                        <ComboBox Margin="0,4,0,0"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemsSource="{Binding AudioChoices}"
                                                  SelectedItem="{Binding SelectedAudioChoice}"
                                                  IsEnabled="{Binding IsMediaReady}" />
                                    </StackPanel>

                                    <StackPanel x:Name="Mp3BitratePanel"
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Visibility="{Binding IsMp3Download, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource LabelText}" Text="MP3 Bitrate" />
                                        <ListBox Margin="0,4,0,0"
                                                 Style="{StaticResource SegmentedListBox}"
                                                 ItemsSource="{Binding Mp3Bitrates}"
                                                 SelectedItem="{Binding SelectedMp3Bitrate}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid x:Name="DownloadFooterGrid" Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    MinHeight="42"
                                    Background="#0A1322"
                                    BorderBrush="#1F2E46"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="10,7">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Width="15"
                                          Height="12"
                                          Fill="#B7C5D8"
                                          Stretch="Uniform"
                                          Data="M10,4 L2,4 C0.9,4 0,4.9 0,6 L0,18 C0,19.1 0.9,20 2,20 L22,20 C23.1,20 24,19.1 24,18 L24,8 C24,6.9 23.1,6 22,6 L12,6 Z" />
                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               Text="Save to"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#D9E2EF" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,5,0"
                                               Text="{Binding OutputDirectory}"
                                               Foreground="#AFC0D5"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               ToolTip="{Binding OutputDirectory}" />
                                </Grid>
                            </Border>

                            <Grid x:Name="DownloadFooterActions" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        MinWidth="88"
                                        MinHeight="42"
                                        Style="{StaticResource GhostButton}"
                                        Padding="12,8"
                                        Command="{Binding BrowseOutputDirectoryCommand}"
                                        Content="Browse" />

                                <Button Grid.Column="3"
                                        Width="42"
                                        MinHeight="42"
                                        Style="{StaticResource GhostButton}"
                                        Padding="0"
                                        Command="{Binding OpenDownloadsCommand}"
                                        ToolTip="Open download folder">
                                    <Path Width="15"
                                          Height="12"
                                          Fill="#DCE6F4"
                                          Stretch="Uniform"
                                          Data="M10,4 L2,4 C0.9,4 0,4.9 0,6 L0,18 C0,19.1 0.9,20 2,20 L22,20 C23.1,20 24,19.1 24,18 L24,8 C24,6.9 23.1,6 22,6 L12,6 Z" />
                                </Button>

                                <Button Grid.Column="5"
                                        MinWidth="150"
                                        MinHeight="42"
                                        Style="{StaticResource NeonPrimaryButton}"
                                        Command="{Binding DownloadCommand}"
                                        Content="Download"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Download the analyzed media with the selected options. Paste a media URL first if this button is disabled." />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Panel 2: Download Queue -->
                <Border x:Name="QueuePanel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" Background="#0B1422" BorderBrush="#1F2D44" BorderThickness="1" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Download Queue" FontWeight="SemiBold" FontSize="13" />
                            <Border Grid.Column="1" Margin="8,0,0,0" MinWidth="24" Height="24" Background="#202B3D" CornerRadius="12" Padding="7,0">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding DownloadQueue.Count}" FontSize="10" />
                            </Border>
                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="8,5" Command="{Binding ClearCompletedCommand}" Content="Clear" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#52647E" Text="No downloads yet." FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DownloadQueue.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding DownloadQueue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0E1828" CornerRadius="9" Padding="9" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.RowSpan="4" Grid.Column="0" Width="56" Height="42" Background="#101C2F" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,3,0,0" Foreground="#76879F" FontSize="8.5" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Quality}" /><Run Text=" · " /><Run Text="{Binding Format}" />
                                                    </TextBlock>
                                                    <Grid Grid.Row="2" Grid.Column="2" Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Style="{StaticResource QueueProgressBar}" Maximum="100" Value="{Binding ProgressPercent}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Foreground="#DDE5F1" FontSize="8.5" />
                                                    </Grid>
                                                    <Grid Grid.Row="3" Grid.Column="2" Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Status}" Foreground="#7E91AD" FontSize="8.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Foreground="#5CAEFF" FontSize="8.5" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Panel 3: Convert -->
                <Border x:Name="ConvertPanel" Grid.Row="0" Grid.Column="4" VerticalAlignment="Top" Background="#0D1625" BorderBrush="#22314A" BorderThickness="1" CornerRadius="14" Padding="13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="110" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Convert" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Margin="0,4,0,10" Text="Local video to MP3" Foreground="#9AA9BD" FontSize="10" />

                        <Border Grid.Row="2" AllowDrop="True" DragOver="ConvertDropZone_DragOver" Drop="ConvertDropZone_Drop"
                                Background="#0A1322" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Rectangle Margin="7" RadiusX="7" RadiusY="7" Stroke="#405473" StrokeThickness="1" StrokeDashArray="4,4" />
                                <Button Margin="8" Style="{StaticResource GhostButton}" Background="Transparent" BorderBrush="Transparent" Command="{Binding BrowseConversionInputCommand}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="♪" FontSize="30" Foreground="#69B5FF" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,7,0,0" Text="{Binding ConversionInputFileName}" HorizontalAlignment="Center" Foreground="#DCE5F1" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        <TextBlock Margin="0,3,0,0" Text="or click to browse" HorizontalAlignment="Center" Foreground="#63A8FF" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <TextBlock Text="Output Format" Foreground="#CBD6E5" FontSize="10" />
                            <Border Margin="0,4,0,0" Background="#10192A" BorderBrush="#28364F" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                <TextBlock Text="MP3" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <TextBlock Text="Bitrate" Foreground="#CBD6E5" FontSize="10" />
                            <ComboBox Margin="0,4,0,0" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding ConversionMp3Bitrates}" SelectedItem="{Binding SelectedConversionBitrate}" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Margin="0,10,0,0" Text="{Binding LastConvertedFile, Mode=OneWay}" Foreground="#6E819D" FontSize="10" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="6" Style="{StaticResource NeonPrimaryButton}" Command="{Binding ConvertLocalFileCommand}" Content="Convert Now" />
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
