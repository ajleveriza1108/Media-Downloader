                                                            Click="QueueRowSubtitlesR1641_Click"
                                                            ToolTip="Download subtitles for this source">
                                                        <Viewbox Width="13" Height="13"><Path Data="{StaticResource IconLibrary}" Stroke="{DynamicResource ThemePrimaryTextBrush}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="1"
                                                            Style="{StaticResource QueueActionButtonR1638}"
                                                            Padding="4"
                                                            Click="QueueRowSourceLinkR1641_Click"
                                                            ToolTip="Copy source link">
                                                        <Viewbox Width="13" Height="13"><Path Data="{StaticResource IconLink}" Stroke="{DynamicResource ThemePrimaryTextBrush}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="1"
                                                            Style="{StaticResource QueueActionButtonR1638}"
                                                            Padding="4"
                                                            Click="QueueRowOpenFileR1641_Click"
                                                            Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="Open downloaded file">
                                                        <Viewbox Width="13" Height="13"><Path Data="{StaticResource IconOpenFile}" Stroke="{DynamicResource ThemeSuccessBrush}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="1"
                                                            Style="{StaticResource QueueActionButtonR1638}"
                                                            Padding="4"
                                                            Click="QueueRowConvertMp3R1641_Click"
                                                            Visibility="{Binding CanConvertToMp3, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="Convert downloaded video to MP3">
                                                        <Viewbox Width="13" Height="13"><Path Data="{StaticResource IconAudio}" Stroke="{DynamicResource ThemePrimaryTextBrush}" StrokeThickness="1.4" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="1"
                                                            Style="{StaticResource QueueActionButtonR1638}"
                                                            Padding="4"
                                                            Click="QueueRowConvertMp4R1641_Click"
                                                            Visibility="{Binding CanRedownloadAsMp4, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="Download this source as MP4">
                                                        <Viewbox Width="13" Height="13"><Path Data="{StaticResource IconScreen}" Stroke="{DynamicResource ThemePrimaryTextBrush}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="1"
                                                            Style="{StaticResource QueueActionButtonR1638}"
                                                            Padding="4"
                                                            Click="QueueRowRefreshR1641_Click"
                                                            ToolTip="Refresh downloaded / converted file status">
                                                        <Viewbox Width="12" Height="12"><Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="1"
                                                            Style="{StaticResource QueueActionButtonR1638}"
                                                            Padding="4"
                                                            Click="QueueRowDeleteR1641_Click"
                                                            ToolTip="Remove from MediaDock or delete the downloaded file">
                                                        <Viewbox Width="13" Height="13"><Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource ThemePrimaryTextBrush}" StrokeThickness="1.5" Fill="Transparent"/></Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Border>

                                                <!-- MEDIADOCK_START_QUEUE_ENABLEMENT_R1641 -->
                <Button x:Name="QueueWorkspaceDownloadReadyR1629"
                        Grid.Row="9"
                        HorizontalAlignment="Right"
                        MinWidth="132"
                        Padding="14,7"
                        Click="QueueWorkspaceStartR1641_Click"
                        Content="Start Queue"
                        ToolTip="Starts selected ready items when any are selected; otherwise starts all ready items."
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NeonPrimaryButton}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DownloadQueue.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid></Grid>
      <!-- =======================================================
                 DOWNLOADER: browser-intercepted and direct file transfers
                 ======================================================= -->
      <Grid x:Name="GeneralDownloaderWorkspace" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource ThemePanelBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Text="DOWNLOADER"
                         Foreground="{DynamicResource ThemeAccentBrush}"
                         FontWeight="SemiBold"
                         FontSize="12" />
              <TextBlock Text="{Binding GeneralDownloadSummaryR1643}"
                         Foreground="{DynamicResource ThemeMutedTextBrush}"
                         FontSize="9" />
            </StackPanel>
            <TextBox x:Name="GeneralDownloadUrlTextBoxR1643"
                     Grid.Column="1"
                     Margin="0,0,8,0"
                     Style="{StaticResource DarkTextBox}"
                     MinHeight="38"
                     VerticalContentAlignment="Center"
                     Text="{Binding GeneralDownloadUrlR1643, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Paste any direct http/https file URL" />
            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Style="{StaticResource NeonPrimaryButton}"
                    Padding="14,8"
                    Content="Download"
                    Click="GeneralDownloadAddR1643_Click" />
            <Button Grid.Column="3"
                    Style="{StaticResource DenseGhostButton}"
                    Padding="12,7"
                    Content="Open Folder"
                    Click="GeneralDownloadOpenFolderR1643_Click" />
          </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemePanelBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
          <Grid>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="No file downloads yet. Browser-intercepted downloads and direct URLs will appear here."
                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                       FontSize="11">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding GeneralDownloadsR1643.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding GeneralDownloadsR1643}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,7"
                            Padding="10"
                            Background="{DynamicResource ThemeSurfaceBrush}"
                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                          <TextBlock Text="{Binding FileName}"
                                     FontWeight="SemiBold"
                                     FontSize="11.5"
                                     Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Margin="0,2,0,0"
                                     Text="{Binding Url}"
                                     FontSize="9"
                                     Foreground="{DynamicResource ThemeMutedTextBrush}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                          <Button Margin="0,0,5,0"
                                  Style="{StaticResource DenseGhostButton}"
                                  Padding="8,4"
                                  Content="Start / Resume"
                                  Tag="{Binding}"
                                  IsEnabled="{Binding CanStartR1643}"
                                  Click="GeneralDownloadStartR1643_Click" />
                          <Button Margin="0,0,5,0"
                                  Style="{StaticResource DenseGhostButton}"
                                  Padding="8,4"
                                  Content="Cancel"
                                  Tag="{Binding}"
                                  IsEnabled="{Binding CanCancelR1643}"
                                  Click="GeneralDownloadCancelR1643_Click" />
                          <Button Style="{StaticResource DenseGhostButton}"
                                  Padding="8,4"
                                  Content="Open"
                                  Tag="{Binding}"
                                  IsEnabled="{Binding CanOpenR1643}"
                                  Click="GeneralDownloadOpenR1643_Click" />
                        </StackPanel>

                        <ProgressBar Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource QueueProgressBar}"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}" />

                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Margin="0,5,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding StatusText}"
                                     FontSize="9.5"
                                     Foreground="{DynamicResource ThemeSecondaryTextBrush}" />
                          <TextBlock Grid.Column="1"
                                     Margin="12,0,0,0"
                                     Text="{Binding SizeTextR1643}"
                                     FontSize="9.5"
                                     Foreground="{DynamicResource ThemeMutedTextBrush}" />
                          <TextBlock Grid.Column="2"
                                     Margin="12,0,0,0"
                                     Text="{Binding SpeedText}"
                                     FontSize="9.5"
                                     Foreground="{DynamicResource ThemeAccentBrush}" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>      <!-- MEDIADOCK_TORRENT_WORKSPACE_R1644 -->
      <!-- MEDIADOCK_THEME_ADAPTIVE_UI_R1646 -->
      <!-- MEDIADOCK_TORRENT_PERSISTENT_QUEUE_SETTINGS_R199 -->
      <Grid x:Name="TorrentWorkspaceR1644"
            Visibility="Collapsed"
            Background="{DynamicResource ThemeWindowBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource ThemePanelBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Background="{DynamicResource ThemeInputBackgroundBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <TextBox x:Name="TorrentSourceTextBoxR1644"
                         Text="{Binding TorrentSourceR1644, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource UrlTextBox}"
                         MinHeight="38"
                         Padding="10,0"
                         ToolTip="Paste a magnet link or HTTPS .torrent URL."/>
              </Border>
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Style="{StaticResource DenseGhostButton}"
                      Padding="12,6"
                      MinWidth="116"
                      Content="Add &amp; Download"
                      Click="TorrentAddMagnetR1644_Click"/>
              <Button Grid.Column="2"
                      Margin="8,0,0,0"
                      Style="{StaticResource NeonPrimaryButton}"
                      Padding="12,6"
                      MinWidth="178"
                      Content="Open &amp; Download .torrent"
                      Click="TorrentAddFileR1644_Click"/>
            </Grid>
            <TextBlock Grid.Row="1"
                       Margin="2,7,0,0"
                       Text="Open, paste, or drop a torrent. Loaded torrents remain in MediaDock after restart and use queue priority from top to bottom."
                       Foreground="{DynamicResource ThemeMutedTextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       TextWrapping="Wrap"/>
          </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemePanelBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="9">
          <Border.Resources>
            <Style x:Key="TorrentActionButtonR194"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource DenseGhostButton}">
              <Setter Property="Padding" Value="9,5"/>
              <Setter Property="Margin" Value="0,0,5,5"/>
              <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
              <Setter Property="MinHeight" Value="30"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTorrentR1644}" Value="{x:Null}">
                  <Setter Property="IsEnabled" Value="False"/>
                  <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Resources>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="5"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <WrapPanel VerticalAlignment="Center">
                <CheckBox Margin="3,0,10,5"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource ThemePrimaryTextBrush}"
                          Content="All"
                          Checked="TorrentSelectAllR199_Checked"
                          Unchecked="TorrentSelectAllR199_Unchecked"
                          ToolTip="Check or uncheck all loaded torrents"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Start" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentStartR1644_Click"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Pause" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentPauseR1644_Click"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Stop" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentStopR1644_Click"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="↑ Priority" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentMoveUpR199_Click" ToolTip="Move selected torrent up the download queue"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="↓ Priority" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentMoveDownR199_Click" ToolTip="Move selected torrent down the download queue"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Update Peers" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentUpdateTrackersR199_Click" ToolTip="Immediately refresh trackers, DHT and local peer discovery"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Files" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentFilesR1644_Click"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Details" Tag="{Binding SelectedItem, ElementName=TorrentGridR1644}" Click="TorrentDetailsR190_Click"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Remove ✓" Click="TorrentRemoveCheckedR199_Click" ToolTip="Remove checked torrents"/>
                <Button Style="{StaticResource TorrentActionButtonR194}" Content="Remove All" Click="TorrentRemoveAllR199_Click"/>
                <Button Margin="0,0,5,5"
                        Style="{StaticResource DenseGhostButton}"
                        Padding="9,5"
                        MinHeight="30"
                        Foreground="{DynamicResource ThemePrimaryTextBrush}"
                        Content="Settings"
                        Click="TorrentSettingsR199_Click"/>
              </WrapPanel>
              <StackPanel Grid.Column="1"
                          Margin="12,0,0,5"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          MinWidth="170">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock Text="Loaded: " Foreground="{DynamicResource ThemeSecondaryTextBrush}" FontSize="10"/>
                  <TextBlock Text="{Binding TorrentsR1644.Count, Mode=OneWay}" Foreground="{DynamicResource ThemePrimaryTextBrush}" FontWeight="SemiBold" FontSize="10"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right"
                           Text="Persistent queue • FAST discovery • DHT/PEX • tracker bootstrap"
                           Foreground="{DynamicResource ThemeMutedTextBrush}"
                           FontSize="8.5"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           MaxWidth="290"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
              <DataGrid x:Name="TorrentGridR1644"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="{DynamicResource ThemeBorderBrush}"
                        VerticalGridLinesBrush="{DynamicResource ThemeBorderBrush}"
                        Background="{DynamicResource ThemePanelBackgroundBrush}"
                        Foreground="{DynamicResource ThemePrimaryTextBrush}"
                        BorderThickness="0"
                        RowHeaderWidth="0"
                        RowHeight="44"
                        ColumnHeaderHeight="40"
                        AlternationCount="2"
                        RowBackground="{DynamicResource ThemePanelBackgroundBrush}"
                        AlternatingRowBackground="{DynamicResource ThemeSurfaceBrush}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ItemsSource="{Binding TorrentsR1644}"
                        SelectedItem="{Binding SelectedTorrentR1644, Mode=TwoWay}">
                <DataGrid.ContextMenu>
                  <ContextMenu Background="{DynamicResource ThemePanelBackgroundBrush}"
                               Foreground="{DynamicResource ThemePrimaryTextBrush}"
                               BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <MenuItem Header="Start / Resume" Click="TorrentStartR1644_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Pause" Click="TorrentPauseR1644_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Stop" Click="TorrentStopR1644_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <Separator/>
                    <MenuItem Header="Move Up Queue" Click="TorrentMoveUpR199_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Move Down Queue" Click="TorrentMoveDownR199_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <Separator/>
                    <MenuItem Header="Files / Priorities" Click="TorrentFilesR1644_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Details / Trackers / Peers" Click="TorrentDetailsR190_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Force Recheck" Click="TorrentRecheckR1644_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Update Trackers / Peers" Click="TorrentUpdateTrackersR199_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Stream" Click="TorrentStreamR1644_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Open Containing Folder" Click="TorrentOpenFolderR190_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <Separator/>
                    <MenuItem Header="Remove…" Click="TorrentRemoveR190_Click" Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                    <MenuItem Header="Torrent Settings" Click="TorrentSettingsR199_Click"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Resources>
                  <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </Style>
                  <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ThemeAccentPanelBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                  <Style x:Key="TorrentGridTextR198" TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  </Style>
                  <Style x:Key="TorrentGridSecondaryTextR198" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TorrentGridTextR198}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}"/>
                  </Style>
                  <Style x:Key="TorrentGridStatusTextR198" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TorrentGridTextR198}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                  </Style>
                  <Style x:Key="TorrentProgressBarR197" TargetType="{x:Type ProgressBar}">
                    <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                  </Style>
                  <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
                    <Setter Property="Padding" Value="7,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  </Style>
                  <Style TargetType="{x:Type CheckBox}">
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryTextBrush}"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                  </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="✓" Width="38">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="#" Binding="{Binding QueuePosition}" Width="38" ElementStyle="{StaticResource TorrentGridSecondaryTextR198}"/>
                  <DataGridTemplateColumn Header="Name" Width="2.1*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource TorrentGridTextR198}" FontWeight="SemiBold"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" ElementStyle="{StaticResource TorrentGridSecondaryTextR198}"/>
                  <DataGridTemplateColumn Header="Status" Width="1.25*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Text="{Binding Status}" ToolTip="{Binding StatusToolTip}" Style="{StaticResource TorrentGridStatusTextR198}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Progress" Width="1.25*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid Margin="2,8">
                          <ProgressBar Maximum="100" Value="{Binding Progress, Mode=OneWay}" Style="{StaticResource TorrentProgressBarR197}"/>
                          <TextBlock Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:0.0}%}"
                                     Foreground="{DynamicResource ThemePrimaryTextBrush}"
                                     FontFamily="Segoe UI"
                                     FontSize="9"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Down" Binding="{Binding DownloadRate, Mode=OneWay}" Width="88" ElementStyle="{StaticResource TorrentGridTextR198}"/>
                  <DataGridTextColumn Header="Up" Binding="{Binding UploadRate, Mode=OneWay}" Width="82" ElementStyle="{StaticResource TorrentGridSecondaryTextR198}"/>
                  <DataGridTextColumn Header="Peers" Binding="{Binding Peers, Mode=OneWay}" Width="56" ElementStyle="{StaticResource TorrentGridTextR198}"/>
                  <DataGridTextColumn Header="Seeds" Binding="{Binding Seeds, Mode=OneWay}" Width="56" ElementStyle="{StaticResource TorrentGridTextR198}"/>
                  <DataGridTextColumn Header="ETA" Binding="{Binding Eta, Mode=OneWay}" Width="76" ElementStyle="{StaticResource TorrentGridSecondaryTextR198}"/>
                  <DataGridTextColumn Header="Ratio" Binding="{Binding Ratio, Mode=OneWay}" Width="64" ElementStyle="{StaticResource TorrentGridSecondaryTextR198}"/>
                </DataGrid.Columns>
              </DataGrid>

              <Border Margin="0,38,0,0"
                      Background="{DynamicResource ThemePanelBackgroundBrush}"
                      IsHitTestVisible="False">
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
