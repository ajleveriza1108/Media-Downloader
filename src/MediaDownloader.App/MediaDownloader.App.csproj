<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MediaDownloader</AssemblyName>
    <RootNamespace>MediaDownloader</RootNamespace>
    <ApplicationIcon>Assets\MediaDock.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
      <Version>1.6.53</Version>
      <AssemblyVersion>1.6.53.0</AssemblyVersion>
      <FileVersion>1.6.53.0</FileVersion>
      <InformationalVersion>R1.6.53</InformationalVersion>
      <Features>$(Features);experimental-data-section-string-literals=100</Features>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\MediaDock.ico" />
    <Resource Include="Assets\MediaDock-icon.png" />
    <Resource Include="Assets\MediaDock-logo.png" />
    <Content Include="Assets\MediaDock-logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>
</Project>
